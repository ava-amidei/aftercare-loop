# Aftercare Loop — environment template. Copy to .env.local (never commit .env.local).

# Live AI provider: auto | gemini | anthropic | scripted (default auto).
#   auto      → Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY
#               is set, else Scripted Demo Mode.
#   gemini / anthropic → only that provider (Scripted Demo Mode if its key is unset).
#   scripted  → always Scripted Demo Mode.
AFTERCARE_PROVIDER=auto

# Server-side only. When no provider key is set, the app runs in Scripted Demo
# Mode with deterministic, clearly-labeled responses for the synthetic demo patients.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini model used for live responses (default: gemini-3.8-flash).
AFTERCARE_GEMINI_MODEL=gemini-3.8-flash

# Claude model used for live responses (default: claude-opus-5-5).
AFTERCARE_MODEL=claude-opus-5-5

# Force Scripted Demo Mode even when a key is present ("true"/"false"). Wins over AFTERCARE_PROVIDER.
AFTERCARE_FORCE_SCRIPTED=false

# Optional: enable live MedlinePlus Connect lookups in the evidence retriever.
AFTERCARE_ENABLE_MEDLINEPLUS_LIVE=false
